{
  "manifest_version": 3,
  "name": "Endel Unlock",
  "version": "2.0",
  "description": "Lecteur autonome pour les soundscapes Endel Web.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["*://app.endel.io/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "duration", "enabled": true, "path": "rules.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://app.endel.io/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://app.endel.io/*"],
      "js": ["ui.js"],
      "css": ["ui.css"],
      "run_at": "document_idle"
    }
  ]
}